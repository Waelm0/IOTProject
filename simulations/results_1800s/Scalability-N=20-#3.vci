config extends Baseline
config sim-time-limit 1800s
config repeat 5
config seed-set 3
config *.numTempHumidity "int(ceil(20 / 2))"
config *.numOccupancyMotion "int(floor(20 / 2))"
config *.numSmokeEnv 2
config *.numActuators 1
config **.app[*].result-recording-modes all
config **.radio.**.result-recording-modes all
config **.tempHumiditySensor[*].numApps 1
config **.tempHumiditySensor[*].app[0].typename UdpBasicApp
config **.tempHumiditySensor[*].app[0].destAddresses "\"gateway\""
config **.tempHumiditySensor[*].app[0].destPort 1000
config **.tempHumiditySensor[*].app[0].sendInterval 10s
config **.tempHumiditySensor[*].app[0].messageLength 50B
config **.tempHumiditySensor[*].app[0].startTime "uniform(0s, 1s)"
config **.tempHumiditySensor[*].app[0].packetName "\"TempHumidityReport\""
config **.occupancyMotionSensor[*].numApps 1
config **.occupancyMotionSensor[*].app[0].typename UdpBasicApp
config **.occupancyMotionSensor[*].app[0].destAddresses "\"gateway\""
config **.occupancyMotionSensor[*].app[0].destPort 1000
config **.occupancyMotionSensor[*].app[0].sendInterval 10s
config **.occupancyMotionSensor[*].app[0].messageLength 50B
config **.occupancyMotionSensor[*].app[0].startTime "uniform(0s, 1s)"
config **.occupancyMotionSensor[*].app[0].packetName "\"OccupancyReport\""
config **.smokeEnvSensor[*].numApps 1
config **.smokeEnvSensor[*].app[0].typename UdpBasicApp
config **.smokeEnvSensor[*].app[0].destAddresses "\"gateway\""
config **.smokeEnvSensor[*].app[0].destPort 1001
config **.smokeEnvSensor[*].app[0].sendInterval 30s
config **.smokeEnvSensor[*].app[0].messageLength 50B
config **.smokeEnvSensor[*].app[0].startTime "uniform(0s, 1s)"
config **.smokeEnvSensor[*].app[0].packetName "\"AlarmEvent\""
config **.actuator[*].numApps 1
config **.actuator[*].app[0].typename UdpSink
config **.actuator[*].app[0].localPort 1002
config **.gateway.numApps 2
config **.gateway.app[0].typename UdpSink
config **.gateway.app[0].localPort 1000
config **.gateway.app[1].typename UdpSink
config **.gateway.app[1].localPort 1001
config **.monitoringApp.numApps 1
config **.monitoringApp.app[0].typename UdpSink
config **.monitoringApp.app[0].localPort 2000
config network SmartHomeNetwork
config sim-time-limit 100s
config **.hasStatus true
config **.tempHumiditySensor[*].wlan[0].typename Ieee802154NarrowbandInterface
config **.occupancyMotionSensor[*].wlan[0].typename Ieee802154NarrowbandInterface
config **.smokeEnvSensor[*].wlan[0].typename Ieee802154NarrowbandInterface
config **.actuator[*].wlan[0].typename Ieee802154NarrowbandInterface
config **.gateway.wlan[0].typename Ieee802154NarrowbandInterface
config **.gateway.hasUdp true
config **.radioMedium.backgroundNoise.power -110dBm
config **.arp.typename GlobalArp
config **.wlan[*].radio.transmitter.power 50mW
config **.wlan[*].radio.receiver.sensitivity -100dBm
config **.tempHumiditySensor[*].mobility.typename StationaryMobility
config **.tempHumiditySensor[*].mobility.initialX "320m + parentIndex() * 30m"
config **.tempHumiditySensor[*].mobility.initialY 240m
config **.occupancyMotionSensor[*].mobility.typename StationaryMobility
config **.occupancyMotionSensor[*].mobility.initialX "320m + parentIndex() * 30m"
config **.occupancyMotionSensor[*].mobility.initialY 260m
config **.smokeEnvSensor[*].mobility.typename StationaryMobility
config **.smokeEnvSensor[*].mobility.initialX "320m + parentIndex() * 30m"
config **.smokeEnvSensor[*].mobility.initialY 280m
config **.actuator[*].mobility.typename StationaryMobility
config **.actuator[*].mobility.initialX "320m + parentIndex() * 30m"
config **.actuator[*].mobility.initialY 300m
config **.gateway.mobility.typename StationaryMobility
config **.gateway.mobility.initialX 400m
config **.gateway.mobility.initialY 280m
config *.configurator.config "xmldoc(\"topology.xml\")"
config **.energyStorage.typename SimpleEpEnergyStorage
config **.energyStorage.nominalCapacity 10000J
config **.energyStorage.initialCapacity 10000J
config **.energyConsumer.typename StateBasedEpEnergyConsumer
config **.energyStorage.residualEnergyCapacity.result-recording-modes +last

