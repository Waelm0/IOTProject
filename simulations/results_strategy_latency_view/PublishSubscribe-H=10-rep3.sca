version 3
run "PublishSubscribe-H=10-rep3-latency-view"
attr configname "PublishSubscribe"
attr experiment "PublishSubscribe"
attr measurement "$H=10"
attr replication "#3"
attr repetition "3"
attr seedset "3"
attr iterationvars "$H=10"
attr network "SmartHomeNetwork"
attr derivedFrom "PublishSubscribe-H=10-rep3.sca"
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMean 0.0044732681490064
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMax 0.0055452681490351001
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyStddev 0.00074065745331074
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencySamples 720
