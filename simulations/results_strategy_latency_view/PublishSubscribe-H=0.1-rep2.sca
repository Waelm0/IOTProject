version 3
run "PublishSubscribe-H=0.1-rep2-latency-view"
attr configname "PublishSubscribe"
attr experiment "PublishSubscribe"
attr measurement "$H=0.1"
attr replication "#2"
attr repetition "2"
attr seedset "2"
attr iterationvars "$H=0.1"
attr network "SmartHomeNetwork"
attr derivedFrom "PublishSubscribe-H=0.1-rep2.sca"
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMean 0.0075515833512343001
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMax 0.039209268149078998
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyStddev 0.0048471885782132001
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencySamples 717
