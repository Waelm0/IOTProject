version 3
run "PublishSubscribe-H=10-rep4-latency-view"
attr configname "PublishSubscribe"
attr experiment "PublishSubscribe"
attr measurement "$H=10"
attr replication "#4"
attr repetition "4"
attr seedset "4"
attr iterationvars "$H=10"
attr network "SmartHomeNetwork"
attr derivedFrom "PublishSubscribe-H=10-rep4.sca"
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMean 0.0044634903712273003
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMax 0.0055452681490351001
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyStddev 0.00073968843236429005
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencySamples 720
