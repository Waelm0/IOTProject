version 3
run "PublishSubscribe-H=0.1-rep3-latency-view"
attr configname "PublishSubscribe"
attr experiment "PublishSubscribe"
attr measurement "$H=0.1"
attr replication "#3"
attr repetition "3"
attr seedset "3"
attr iterationvars "$H=0.1"
attr network "SmartHomeNetwork"
attr derivedFrom "PublishSubscribe-H=0.1-rep3.sca"
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMean 0.0056017020850271
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMax 0.040569268149056002
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyStddev 0.0040156167667746
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencySamples 719
