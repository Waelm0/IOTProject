version 3
run "RequestResponse-T=1,H=10-rep4-latency-view"
attr configname "RequestResponse"
attr experiment "RequestResponse"
attr measurement "$T=1, $H=10"
attr replication "#4"
attr repetition "4"
attr seedset "4"
attr iterationvars "$T=1, $H=10"
attr network "SmartHomeNetwork"
