version 3
run "PublishSubscribe-H=0.1-rep4-latency-view"
attr configname "PublishSubscribe"
attr experiment "PublishSubscribe"
attr measurement "$H=0.1"
attr replication "#4"
attr repetition "4"
attr seedset "4"
attr iterationvars "$H=0.1"
attr network "SmartHomeNetwork"
attr derivedFrom "PublishSubscribe-H=0.1-rep4.sca"
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMean 0.0075963922773167004
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyMax 0.047737268148978003
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencyStddev 0.0062251213151307003
attr unit s
scalar SmartHomeNetwork.monitoringApp.app[0] eventLatencySamples 717
