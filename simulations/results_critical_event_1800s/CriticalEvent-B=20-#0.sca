attr configname CriticalEvent
attr datetime 20260911-03:04:50
attr datetimef 20260911-030450
attr experiment CriticalEvent
attr inifile omnetpp.ini
attr iterationvars $B=20
attr iterationvarsd B=20
attr iterationvarsf B=20-
attr measurement $B=20
attr network SmartHomeNetwork
attr processid 11128
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 10
attr seedset 0
itervar B 20
config image-path ../../../inet4.6/images
config extends Baseline
config sim-time-limit 1800s
config repeat 5
config seed-set 0
config *.numTempHumidity "int(ceil(20 / 2))"
config *.numOccupancyMotion "int(floor(20 / 2))"
