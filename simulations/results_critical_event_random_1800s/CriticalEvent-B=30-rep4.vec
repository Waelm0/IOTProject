config image-path ../../../inet4.6/images
config extends Baseline
config sim-time-limit 1800s
config repeat 5
config seed-set 4
config *.numTempHumidity "int(ceil(30 / 2))"
config *.numOccupancyMotion "int(floor(30 / 2))"
config *.numSmokeEnv 2
config *.numActuators 1
config **.tempHumiditySensor[*].app[0].sendInterval 10s
config **.occupancyMotionSensor[*].app[0].sendInterval 10s
config **.smokeEnvSensor[*].app[0].startTime "uniform(300s, 600s)"
config **.smokeEnvSensor[*].app[0].sendInterval exponential(30s)
config **.smokeEnvSensor[*].app[0].messageLength 50B
config **.smokeEnvSensor[*].app[0].packetName "\"CriticalSmokeAlarm\""
config result-dir results_critical_event_random_1800s
config output-scalar-file results_critical_event_random_1800s/CriticalEvent-B=30-rep4.sca
config output-vector-file results_critical_event_random_1800s/CriticalEvent-B=30-rep4.vec
config **.gateway.app[1].endToEndDelay.vector-recording true
config **.vector-recording false
config **.app[*].result-recording-modes all
config **.radio.**.result-recording-modes all
config **.mac.**.result-recording-modes all
config **.tempHumiditySensor[*].numApps 1
config **.tempHumiditySensor[*].app[0].typename UdpBasicApp
config **.tempHumiditySensor[*].app[0].destAddresses "\"gateway\""
config **.tempHumiditySensor[*].app[0].destPort 1000
config **.tempHumiditySensor[*].app[0].sendInterval 10s
config **.tempHumiditySensor[*].app[0].messageLength 50B
